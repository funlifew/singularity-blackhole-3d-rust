# Cargo build output (Cargo.lock is committed for reproducible application builds)
/target/
/dist/

# Local captures; curated README images in docs/screenshots stay tracked
/screenshots/

# Compiler and tool artifacts
**/*.rs.bk
*.pdb
rustc-ice-*.txt
**/mutants.out*/
/coverage/
*.profraw
*.profdata

# Local editor and OS files
/.idea/
/.vscode/
.DS_Store
Thumbs.db
*~
*.swp
*.swo

# Local configuration and secrets
.env
.env.*
!.env.example

# Python tooling used for packaging and render validation
__pycache__/
*.py[cod]
